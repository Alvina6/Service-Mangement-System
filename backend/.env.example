PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/serviceflow
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:3000

# Google OAuth - obtain from Google Cloud Console > APIs & Services > Credentials
# Create an OAuth 2.0 Web Application client and add http://localhost:3000 to
# Authorized JavaScript Origins. No Redirect URIs are needed (popup flow).
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
